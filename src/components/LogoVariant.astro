---
// Logo concepts for The Learning Rate, as theme-aware inline SVG marks.
// Pick one with <LogoVariant variant="gradient-descent" />.
export const VARIANTS = [
  { id: 'bell', label: 'bell curve' },
  { id: 'gradient-descent', label: 'gradient descent' },
  { id: 'sigmoid', label: 'sigmoid' },
  { id: 'regression', label: 'regression fit' },
  { id: 'neural-net', label: 'neural net node' },
  { id: 'mixture', label: 'mixture of gaussians' },
  { id: 'loss-curve', label: 'loss curve' },
  { id: 'decision-boundary', label: 'decision boundary' },
  { id: 'integral', label: 'integral (area)' },
  { id: 'derivative', label: 'derivative (tangent)' },
  { id: 'vectors', label: 'vectors' },
  { id: 'matrix', label: 'matrix' },
  { id: 'linear-transform', label: 'linear transform' },
  { id: 'box-plot', label: 'box plot' },
  { id: 'venn', label: 'venn / sets' },
  { id: 'contours', label: 'contours / gradient' },
  { id: 'poisson', label: 'poisson distribution' },
];

interface Props {
  variant: string;
  height?: number;
  class?: string;
}
const { variant, height = 72, class: className = '' } = Astro.props;
const width = Math.round((height * 120) / 100);
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 120 100"
  fill="none"
  role="img"
  aria-label={`The Learning Rate logo concept: ${variant}`}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {variant === 'bell' && (
    <g>
      <g stroke="var(--accent)" stroke-width="3" opacity="0.45">
        <line x1="26" y1="86" x2="26" y2="79" /><line x1="37" y1="86" x2="37" y2="64" />
        <line x1="49" y1="86" x2="49" y2="45" /><line x1="60" y1="86" x2="60" y2="34" />
        <line x1="71" y1="86" x2="71" y2="45" /><line x1="83" y1="86" x2="83" y2="64" />
        <line x1="94" y1="86" x2="94" y2="79" />
      </g>
      <path d="M19 86 C 41 86 47 36 60 30 C 73 36 79 86 101 86" stroke="var(--ink)" stroke-width="3" />
      <path d="M20 86.4 C 42 85 48 38 60 32 C 72 38 78 85 100 86.3" stroke="var(--ink)" stroke-width="1.6" opacity="0.5" />
      <path d="M17 86 Q 41 88 60 85.5 T 103 86" stroke="var(--ink-soft)" stroke-width="2.4" />
      <circle cx="60" cy="30" r="6.5" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'gradient-descent' && (
    <g>
      <path d="M16 30 C 40 30 44 84 60 84 C 76 84 80 30 104 30" stroke="var(--accent)" stroke-width="3" />
      <path d="M17 31 C 41 31 45 83 60 82.6 C 75 83 79 31 103 31" stroke="var(--accent)" stroke-width="1.6" opacity="0.5" />
      <g fill="var(--ink-soft)"><circle cx="42" cy="62" r="2.1" /><circle cx="48" cy="71" r="2.1" /><circle cx="54" cy="79" r="2.1" /></g>
      <circle cx="35" cy="52" r="7.5" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'sigmoid' && (
    <g>
      <line x1="16" y1="84" x2="60" y2="84" stroke="var(--ink-soft)" stroke-width="2" stroke-dasharray="4 4" />
      <line x1="60" y1="26" x2="104" y2="26" stroke="var(--ink-soft)" stroke-width="2" stroke-dasharray="4 4" />
      <path d="M16 84 C 40 84 46 80 60 55 C 74 30 80 26 104 26" stroke="var(--accent)" stroke-width="3" />
      <path d="M17 84.6 C 41 84 47 79 60 56.4 C 73 32 79 27 103 26.6" stroke="var(--accent)" stroke-width="1.6" opacity="0.5" />
      <circle cx="60" cy="55" r="6.5" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'regression' && (
    <g>
      <path d="M16 88 Q 60 56 104 34" stroke="var(--ink)" stroke-width="2.8" />
      <g fill="var(--accent2)">
        <circle cx="24" cy="84" r="3.4" /><circle cx="34" cy="80" r="3.4" /><circle cx="44" cy="72" r="3.4" />
        <circle cx="54" cy="66" r="3.4" /><circle cx="62" cy="62" r="3.4" /><circle cx="72" cy="52" r="3.4" />
        <circle cx="82" cy="46" r="3.4" /><circle cx="90" cy="42" r="3.4" /><circle cx="98" cy="36" r="3.4" />
      </g>
    </g>
  )}

  {variant === 'neural-net' && (
    <g>
      <g stroke="var(--accent)" stroke-width="2">
        <line x1="22" y1="34" x2="62" y2="58" /><line x1="22" y1="58" x2="62" y2="58" /><line x1="22" y1="82" x2="62" y2="58" />
        <line x1="62" y1="58" x2="100" y2="58" />
      </g>
      <g fill="var(--bg)" stroke="var(--ink)" stroke-width="2.2">
        <circle cx="22" cy="34" r="6.5" /><circle cx="22" cy="58" r="6.5" /><circle cx="22" cy="82" r="6.5" />
        <circle cx="100" cy="58" r="6.5" />
      </g>
      <circle cx="62" cy="58" r="9" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'mixture' && (
    <g>
      <line x1="12" y1="86" x2="108" y2="86" stroke="var(--ink-soft)" stroke-width="2" />
      <path d="M14 86 C 30 86 34 42 46 38 C 58 42 62 86 78 86" stroke="var(--accent)" stroke-width="3" />
      <path d="M42 86 C 58 86 62 42 74 38 C 86 42 90 86 106 86" stroke="var(--accent2)" stroke-width="3" />
    </g>
  )}

  {variant === 'loss-curve' && (
    <g>
      <line x1="14" y1="90" x2="106" y2="90" stroke="var(--ink-soft)" stroke-width="2" />
      <path d="M16 26 C 36 28 44 70 60 78 C 76 83 88 86 104 86" stroke="var(--accent)" stroke-width="3" />
      <path d="M17 27 C 37 29 45 69 60 79.2 C 76 84 88 87 103 86.8" stroke="var(--accent)" stroke-width="1.6" opacity="0.5" />
      <g fill="var(--accent2)">
        <circle cx="16" cy="26" r="3.8" /><circle cx="34" cy="48" r="3.8" /><circle cx="52" cy="72" r="3.8" />
        <circle cx="74" cy="82" r="3.8" /><circle cx="96" cy="85" r="3.8" />
      </g>
    </g>
  )}

  {variant === 'decision-boundary' && (
    <g>
      <path d="M22 94 C 46 70 70 52 100 24" stroke="var(--ink)" stroke-width="2.6" stroke-dasharray="5 4" />
      <g fill="var(--accent)"><circle cx="28" cy="34" r="3.6" /><circle cx="42" cy="28" r="3.6" /><circle cx="34" cy="50" r="3.6" /><circle cx="52" cy="38" r="3.6" /><circle cx="46" cy="58" r="3.6" /></g>
      <g fill="var(--accent2)"><circle cx="78" cy="84" r="3.6" /><circle cx="90" cy="76" r="3.6" /><circle cx="70" cy="72" r="3.6" /><circle cx="96" cy="62" r="3.6" /><circle cx="82" cy="60" r="3.6" /></g>
    </g>
  )}

  {variant === 'integral' && (
    <g>
      <g fill="var(--accent)" fill-opacity="0.28" stroke="var(--accent)" stroke-width="1.5">
        <rect x="24" y="70" width="16" height="16" /><rect x="40" y="58" width="16" height="28" />
        <rect x="56" y="46" width="16" height="40" /><rect x="72" y="36" width="16" height="50" />
        <rect x="88" y="28" width="16" height="58" />
      </g>
      <path d="M24 72 C 44 66 64 44 104 26" stroke="var(--ink)" stroke-width="2.8" />
      <line x1="20" y1="86" x2="108" y2="86" stroke="var(--ink-soft)" stroke-width="2" />
    </g>
  )}

  {variant === 'derivative' && (
    <g>
      <path d="M16 84 C 36 40 84 40 104 84" stroke="var(--accent)" stroke-width="3" />
      <line x1="56" y1="46" x2="102" y2="74" stroke="var(--ink)" stroke-width="2.4" />
      <circle cx="80" cy="58" r="6" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'vectors' && (
    <g>
      <line x1="24" y1="84" x2="96" y2="42" stroke="var(--accent)" stroke-width="3" />
      <path d="M96 42 L87 42 M96 42 L94 51" stroke="var(--accent)" stroke-width="3" />
      <line x1="24" y1="84" x2="54" y2="26" stroke="var(--accent2)" stroke-width="3" />
      <path d="M54 26 L48 32 M54 26 L57 34" stroke="var(--accent2)" stroke-width="3" />
      <circle cx="24" cy="84" r="2.6" fill="var(--ink)" />
    </g>
  )}

  {variant === 'matrix' && (
    <g>
      <path d="M30 26 L20 26 L20 86 L30 86" stroke="var(--ink)" stroke-width="2.6" />
      <path d="M90 26 L100 26 L100 86 L90 86" stroke="var(--ink)" stroke-width="2.6" />
      <circle cx="40" cy="40" r="4" fill="var(--accent)" /><circle cx="60" cy="40" r="4" fill="var(--accent2)" /><circle cx="80" cy="40" r="4" fill="var(--accent)" />
      <circle cx="40" cy="56" r="4" fill="var(--accent2)" /><circle cx="60" cy="56" r="4" fill="var(--accent)" /><circle cx="80" cy="56" r="4" fill="var(--accent2)" />
      <circle cx="40" cy="72" r="4" fill="var(--accent)" /><circle cx="60" cy="72" r="4" fill="var(--accent2)" /><circle cx="80" cy="72" r="4" fill="var(--accent)" />
    </g>
  )}

  {variant === 'linear-transform' && (
    <g>
      <g stroke="var(--ink-soft)" stroke-width="1.6" opacity="0.55">
        <rect x="28" y="38" width="44" height="44" /><line x1="50" y1="38" x2="50" y2="82" /><line x1="28" y1="60" x2="72" y2="60" />
      </g>
      <g stroke="var(--accent)" stroke-width="2.4">
        <path d="M44 38 L92 38 L76 82 L28 82 Z" />
        <line x1="68" y1="38" x2="52" y2="82" /><line x1="36" y1="60" x2="84" y2="60" />
      </g>
    </g>
  )}

  {variant === 'box-plot' && (
    <g>
      <line x1="16" y1="56" x2="104" y2="56" stroke="var(--ink-soft)" stroke-width="2" />
      <line x1="16" y1="49" x2="16" y2="63" stroke="var(--ink-soft)" stroke-width="2" />
      <line x1="104" y1="49" x2="104" y2="63" stroke="var(--ink-soft)" stroke-width="2" />
      <rect x="44" y="44" width="40" height="24" fill="var(--accent)" fill-opacity="0.22" stroke="var(--ink)" stroke-width="2.4" />
      <line x1="64" y1="44" x2="64" y2="68" stroke="var(--accent2)" stroke-width="3" />
    </g>
  )}

  {variant === 'venn' && (
    <g>
      <circle cx="48" cy="58" r="26" fill="var(--accent)" fill-opacity="0.26" stroke="var(--accent)" stroke-width="2.4" />
      <circle cx="74" cy="58" r="26" fill="var(--accent2)" fill-opacity="0.26" stroke="var(--accent2)" stroke-width="2.4" />
    </g>
  )}

  {variant === 'contours' && (
    <g>
      <ellipse cx="64" cy="56" rx="34" ry="24" stroke="var(--ink-soft)" stroke-width="1.6" opacity="0.6" />
      <ellipse cx="64" cy="56" rx="23" ry="16" stroke="var(--accent)" stroke-width="2" />
      <ellipse cx="64" cy="56" rx="12" ry="8" stroke="var(--accent)" stroke-width="2" />
      <line x1="30" y1="26" x2="57" y2="49" stroke="var(--accent2)" stroke-width="2.6" />
      <path d="M57 49 L48 48 M57 49 L53 56" stroke="var(--accent2)" stroke-width="2.6" />
      <circle cx="64" cy="56" r="3.5" fill="var(--accent2)" />
    </g>
  )}

  {variant === 'poisson' && (
    <g>
      <line x1="14" y1="86" x2="106" y2="86" stroke="var(--ink-soft)" stroke-width="2.2" />
      <path
        d="M18 72 Q 29 45 39 24 Q 50 20 60 40 Q 71 58 81 72 Q 92 80 102 84"
        stroke="var(--ink-soft)" stroke-width="1.6" stroke-dasharray="3 4" opacity="0.5"
      />
      <g stroke="var(--accent)" stroke-width="3.2">
        <line x1="18" y1="86" x2="18" y2="72" /><line x1="29" y1="86" x2="29" y2="45" />
        <line x1="39" y1="86" x2="39" y2="24" /><line x1="50" y1="86" x2="50" y2="24" />
        <line x1="60" y1="86" x2="60" y2="40" /><line x1="71" y1="86" x2="71" y2="58" />
        <line x1="81" y1="86" x2="81" y2="72" /><line x1="92" y1="86" x2="92" y2="80" />
        <line x1="102" y1="86" x2="102" y2="84" />
      </g>
      <g fill="var(--accent2)">
        <circle cx="18" cy="72" r="4.2" /><circle cx="29" cy="45" r="4.2" />
        <circle cx="39" cy="24" r="4.6" /><circle cx="50" cy="24" r="4.6" />
        <circle cx="60" cy="40" r="4.2" /><circle cx="71" cy="58" r="4.2" />
        <circle cx="81" cy="72" r="4.2" /><circle cx="92" cy="80" r="4.2" />
        <circle cx="102" cy="84" r="4.2" />
      </g>
    </g>
  )}
</svg>
