---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, type TagGroup } from '../../utils/tags';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

interface Props {
  tag: TagGroup;
}
const { tag } = Astro.props;
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`#${tag.label}`} description={`Posts tagged ${tag.label}.`}>
  <a class="back-link" href="/tags/">← all tags</a>
  <div class="eyebrow" style="margin-top:14px;">tag</div>
  <h1>#{tag.label}</h1>
  <p class="lede">
    {tag.posts.length} post{tag.posts.length === 1 ? '' : 's'} tagged “{tag.label}”.
  </p>

  <ul class="post-list">
    {tag.posts.map((post) => (
      <li class="post-card" data-sketch-frame>
        <a class="card-title" href={`/posts/${post.id}`}>{post.data.title}</a>
        <div class="meta">{fmt(post.data.pubDate)}</div>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
