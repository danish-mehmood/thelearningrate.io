---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoVariant, { VARIANTS } from '../components/LogoVariant.astro';
---

<BaseLayout title="Logo Lab" description="Experimenting with logo marks for The Learning Rate.">
  <a class="back-link" href="/">← home</a>
  <div class="eyebrow" style="margin-top:14px;">experiments</div>
  <h1>Logo lab</h1>
  <p class="lede">
    Eight ML-flavoured marks, live and theme-aware. Flip your system light/dark to see each
    in both. Each card shows the mark big, then at header size next to the wordmark.
  </p>

  <div class="lab-grid">
    {VARIANTS.map((v, i) => (
      <div class="lab-card" data-sketch-frame>
        <div class="lab-big">
          <LogoVariant variant={v.id} height={92} />
        </div>
        <div class="lab-head">
          <LogoVariant variant={v.id} height={34} />
          <span class="lab-word">The Learning Rate</span>
        </div>
        <div class="lab-label">{i + 1} · {v.label}</div>
      </div>
    ))}
  </div>

  <style>
    .lab-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin: 1.8em 0 1em;
    }
    @media (max-width: 520px) {
      .lab-grid { grid-template-columns: 1fr; }
    }
    .lab-card {
      position: relative;
      background: var(--panel);
      border-radius: 12px;
      padding: 22px 18px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      box-shadow: 0 12px 30px -24px rgba(0, 0, 0, 0.55);
    }
    .lab-big {
      display: grid;
      place-items: center;
      min-height: 100px;
    }
    .lab-head {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      transform: rotate(-1.5deg);
    }
    .lab-word {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--ink);
      line-height: 1;
    }
    .lab-label {
      font-family: var(--font-hand);
      color: var(--ink-soft);
      font-size: 1.05rem;
    }
  </style>
</BaseLayout>
